# ─────────────────────────────────────────────────────────────
#  Telegram (обязательно)
# ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=

# ID администраторов через запятую (кому доступны /admin и т.д.).
# Свой id можно узнать у @userinfobot.
ADMIN_IDS=

# Закрытая группа клуба (нужна с этапа 4; на этапе 0 можно оставить пустым).
# club_chat_id: числовой id супергруппы вида -100123456789.
CLUB_CHAT_ID=
# Инвайт-ссылка группы с включённой заявкой на вступление.
CLUB_CHAT_INVITE_URL=

# ─────────────────────────────────────────────────────────────
#  База данных (встроенный Postgres из docker-compose)
# ─────────────────────────────────────────────────────────────
# Пароль для встроенного Postgres (прод). Задайте свой, без пробелов.
POSTGRES_PASSWORD=change_me_strong_password
# (необязательно) пользователь и имя БД:
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres

# Отдельная схема под этот бот (создаётся автоматически, чужие схемы не трогаются).
DB_SCHEMA=club_bot

# ─────────────────────────────────────────────────────────────
#  ЮKassa (нужно с этапа 3)
# ─────────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда ЮKassa вернёт пользователя после оплаты. Можно оставить пустым —
# тогда соберётся автоматически как ссылка на бота (https://t.me/<username>).
YOOKASSA_RETURN_URL=
# Как часто опрашивать pending-платежи (минуты).
PAYMENT_POLL_INTERVAL_MIN=1
# Как часто проверять окончания подписок (минуты): 1 — каждую минуту (тест), 60 — раз в час.
EXPIRY_CHECK_INTERVAL_MIN=30
# Единица длительности: months (прод) или minutes (ТЕСТ — подписка истекает за минуты,
# чтобы вживую проверить авто-кик из группы). В режиме minutes 1/3/6/12 = минуты.
SUBSCRIPTION_UNIT=months
# Чек 54-ФЗ: ВРЕМЕННАЯ заглушка email покупателя (потом заменяется на реальный сбор).
RECEIPT_EMAIL_PLACEHOLDER=receipt@example.com

# ─────────────────────────────────────────────────────────────
#  Прочее
# ─────────────────────────────────────────────────────────────
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
#  Только для запуска БЕЗ Docker (python -m src.main) или для подключения
#  к уже запущенным на ПК pg/redis. В docker-compose эти значения
#  подставляются автоматически — здесь обычно не нужны.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5432/postgres
# REDIS_URL=redis://localhost:6379/0
